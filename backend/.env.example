# ---------------------------------------------------------------
# This is a TEMPLATE with placeholder values - do NOT use these as-is.
# Locally: copy this file to ".env" and fill in your real values.
# On Vercel: set the real values in Project Settings -> Environment Variables
#            (the .env file is NOT deployed to Vercel).
# ---------------------------------------------------------------

# Server
PORT=4000
NODE_ENV=development

# MongoDB Atlas connection string.
# Put YOUR password inside it. If the password contains special
# characters (@ : / ? # & %) they MUST be URL-encoded, e.g.
# "@" -> "%40", "#" -> "%23", "/" -> "%2F".
# Example shape:
#   mongodb+srv://<user>:<password>@<cluster-host>/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/movie_theater?retryWrites=true&w=majority

# JSON Web Token secret - use a long random string
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# URL of the frontend allowed to call this API (CORS).
# You may use CORS_ORIGIN, FRONTEND_URL or CLIENT_URL - all three work.
# Comma-separated for several origins, or "*" to allow all.
# On Vercel (two projects) set this to your frontend, e.g. https://your-app.vercel.app
CORS_ORIGIN=http://localhost:3000
# FRONTEND_URL=https://your-frontend.vercel.app

# Optional: used by `npm run seed` to create your first admin account.
# Leave blank to skip.
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: once at least one admin exists, /api/admin/register requires
# this value in the "x-setup-key" header. Leave blank to keep it closed.
ADMIN_SETUP_KEY=
