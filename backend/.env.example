# ---------------------------------------------------------------
# Copy this file to ".env" and fill in your own values.
# NEVER commit the real ".env" file.
# ---------------------------------------------------------------

# Server
PORT=4000
NODE_ENV=development

# MongoDB Atlas connection string.
# Put YOUR password inside it. If the password contains special
# characters (@ : / ? # & %) they MUST be URL-encoded, e.g.
# "@" -> "%40", "#" -> "%23", "/" -> "%2F".
# Example shape:
MONGODB_URI=mongodb+srv://jarryullah46_db_user:Pakistan123@cluster0.xjzt9fh.mongodb.net/

# JSON Web Token secret - use a long random string
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call the API
CORS_ORIGIN=https://movie-theater-rose.vercel.app

# Optional: used by `npm run seed` to create your first admin account.
# Leave blank to skip.
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: once at least one admin exists, /api/admin/register requires
# this value in the "x-setup-key" header. Leave blank to keep it closed.
ADMIN_SETUP_KEY=
FRONTEND_URL=movie-theater-rose.vercel.app

